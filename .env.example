# =============================================================================
# Copy to .env and fill in secrets. Never commit .env.
# Used by: Express backend (dotenv), ML service (python-dotenv / os.getenv),
#          and the Vite frontend at build time (VITE_* only).
# =============================================================================

# --- Node.js Express API -----------------------------------------------------
# development | test | production
NODE_ENV=development
# Listen port for the Express API
PORT=4000
# PostgreSQL connection string (matches docker-compose defaults)
DATABASE_URL=postgresql://mlapp:mlapp@localhost:5432/mlapp
# Base URL of the Python ML service (no trailing slash)
ML_SERVICE_URL=http://localhost:8000
# Comma-separated list of allowed browser origins for Express CORS
# (set to the frontend's Vercel URL in production)
CORS_ORIGIN=http://localhost:5173
# Session / JWT signing secret — replace before enabling auth
AUTH_SECRET=replace-with-a-long-random-string

# --- Python ML service -------------------------------------------------------
# Listen port when starting uvicorn locally
ML_PORT=8000
# Comma-separated list of browser origins allowed to call the ML service directly
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: where datasets/models are written
# (defaults to the repo locally, /tmp/ml-service on Vercel)
# ML_STORAGE_DIR=/tmp/ml-service
# Vercel Blob token (added automatically when a Blob store is connected).
# Needed on Vercel so uploaded datasets and trained models survive across
# function instances.
# BLOB_READ_WRITE_TOKEN=

# --- Groq (open-source LLM hosting; optional until agents are wired) ---------
GROQ_API_KEY=replace-me

# --- Langfuse tracing (optional until agents are wired) ----------------------
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_PUBLIC_KEY=replace-me
# Prefer LANGFUSE_BASE_URL; LANGFUSE_HOST is kept for older clients
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Frontend (VITE_* are embedded at build time; public values only) --------
# Leave VITE_API_URL empty locally to use the Vite dev proxy;
# set it to the backend's public URL in production
VITE_API_URL=
# Optional direct ML-service URL (fallback for /dataset/parse only)
# VITE_ML_URL=
