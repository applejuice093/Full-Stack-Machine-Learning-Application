# Node.js API
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mlapp:mlapp@localhost:5432/mlapp
ML_SERVICE_URL=http://localhost:8000
# Comma-separated list of allowed browser origins (set to the frontend's Vercel URL in production)
CORS_ORIGIN=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-string

# Python ML service
ML_PORT=8000
# Comma-separated list of browser origins allowed to call the ML service directly
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: where datasets/models are written (defaults to the repo locally, /tmp/ml-service on Vercel)
# ML_STORAGE_DIR=/tmp/ml-service
# Vercel Blob token (added automatically when a Blob store is connected to the ML project).
# Needed on Vercel so uploaded datasets and trained models survive across function instances.
# BLOB_READ_WRITE_TOKEN=

# Groq — open-source models
GROQ_API_KEY=replace-me

# Langfuse
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Frontend (public values only)
# Leave VITE_API_URL empty locally to use the Vite dev proxy; set it to the backend's Vercel URL in production
VITE_API_URL=
# Optional direct ML-service URL (fallback for /dataset/parse only)
# VITE_ML_URL=
